    "probe_source": "import json, os, sys\nfrom pathlib import Path\nfrom unittest.mock import patch\nroot, directory, scenario, mode = sys.argv[1:]\nsys.path[:0] = [str(Path(root)/'src'), str(Path(root)/'tests/unit')]\nfrom test_persistence import INITIAL, FIXTURES, prepare, reserve, reopen\nfrom test_reconciliation import query, reply\nfrom ardrec.messages import MessageError, encode_message\nfrom ardrec.persistence import DurableStore\nfrom ardrec.reconciliation import complete_query, inspect_recovery\nfrom ardrec.temporal import MonotonicTimer\nimport pickle\npath = Path(directory)/scenario\nold = json.loads((Path(root)/'tests/fixtures/messages-v2.json').read_text())\n\ndef summary(store):\n    decision = inspect_recovery(store)\n    assert decision.new_execution_authorized is False\n    return {'head': store.head_sha256, 'action': decision.action,\n            'attempts': len(store.state.attempts),\n            'reports': len(store.state.attempts[0].reports),\n            'queries': decision.queries_used,\n            'result': None if decision.result is None else decision.result.hex(),\n            'temporal': store.temporal_status, 'authorized': False}\n\nif mode == 'write':\n    # Solo el caso histórico reproduce admisión antigua; no se altera el lector.\n    from contextlib import nullcontext\n    with (patch('ardrec.temporal.audit_current') if scenario == 'legacy' else nullcontext()):\n        store = DurableStore.create(path, INITIAL)\n        prepare(store)\n        if scenario in ('legacy','rejected_query'):\n            store.reserve(old['request'], decision_reference='DEC-1')\n        else:\n            reserve(store)\n        if scenario == 'completed': store.report('ATT-1', FIXTURES['result_completed'])\n        if scenario == 'legacy': store.report('ATT-1', old['result_completed'])\n        if scenario == 'rejected_query':\n            q = query(store); response, result = reply(q, result=old['result_completed'])\n            before = store.head_sha256\n            try: complete_query(store, q, response, result=result)\n            except MessageError as error: assert error.code == 'temporal_inversion'\n            else: raise AssertionError('Inversión temporal admitida')\n            assert store.head_sha256 == before\n    # No ejecuta finally/close: terminación del proceso después de escritura durable.\n    print(json.dumps({'head': store.head_sha256}), flush=True)\n    os._exit(0)\n\nassert mode == 'read'\nsaved = {str(p.relative_to(path)):p.read_bytes() for p in path.rglob('*') if p.is_file()}\nwith reopen(path) as store:\n    value = summary(store)\n    expected = {'pending':'QUERY_REQUIRED', 'completed':'READY_FOR_VALIDATION',\n                'legacy':'TEMPORAL_REVIEW_REQUIRED', 'rejected_query':'QUERY_INCOMPLETE'}[scenario]\n    assert value['action'] == expected, value\n    assert value['attempts'] == 1\n    if scenario == 'completed':\n        assert value['result'] == encode_message(FIXTURES['result_completed']).hex()\n        assert value['reports'] == 1\n    if scenario == 'pending': assert value['reports'] == value['queries'] == 0\n    if scenario == 'rejected_query':\n        assert value['queries'] == 1 and value['reports'] == 0\n        assert inspect_recovery(store).open_query is not None\n    if scenario == 'legacy':\n        assert value['reports'] == 1\n        try: store.report('ATT-1', old['result_completed'])\n        except MessageError as error: assert error.code == 'temporal_inversion'\n        else: raise AssertionError('Diario histórico promovido')\n        assert store.head_sha256 == value['head']\nassert saved == {str(p.relative_to(path)):p.read_bytes() for p in path.rglob('*') if p.is_file()}\n# Ningún origen monotónico del proceso escritor se transporta o reconstruye.\ntimer = MonotonicTimer()\nassert timer.elapsed_ms() >= 0\ntry: pickle.dumps(timer)\nexcept TypeError as error: assert 'not_persistable' in str(error)\nelse: raise AssertionError('Origen monotónico serializable')\nprint(json.dumps(value), flush=True)\n",
