# Source-only candidate, NOT INSTALLED.
[Unit]
Description=ARDREC R34 periodic deny-only readback or scoped recreation
After=local-fs.target
RequiresMountsFor=/var/lib/ardrec/r58a-r34-boot

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /var/lib/ardrec/r58a-r34-boot/boot-guard.py
TimeoutStartSec=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
